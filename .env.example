VITE_API_BASE_URL=http://localhost:5000
PORT=5000
DEBUG=False
CLAUDE_API_KEY=sk-ant-api03-xxxxx

# Server-only (never VITE_-prefixed - these must not reach the browser bundle).
# From Groww Cloud API Keys page (groww.in/trade-api/api-keys). The backend
# exchanges these for a real Access Token itself (see getGrowwAccessToken in
# server.js) and caches it until it's close to its daily 6 AM IST expiry.
GROWW_API_KEY=your_groww_api_key
GROWW_API_SECRET=your_groww_api_secret
