VITE_API_BASE_URL=http://localhost:5055
PORT=5056
DEBUG=False

# Server-only (never VITE_-prefixed - these must not reach the browser bundle).
# From Groww Cloud API Keys page (groww.in/trade-api/api-keys). The backend
# exchanges these for a real Access Token itself (see getGrowwAccessToken in
# server.js) and caches it until it's close to its daily 6 AM IST expiry.
GROWW_API_KEY=your_groww_api_key
GROWW_API_SECRET=your_groww_api_secret

# Azure OpenAI (used for AI inference on option chain data - see analyzeWithAI
# in server.js). From your Azure OpenAI resource in the Azure Portal.
AZURE_OPENAI_API_KEY=your_azure_openai_api_key
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=your_deployment_name
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Embedding deployment on the SAME Azure OpenAI resource/key as above (text-embedding-3-small,
# 1536 dimensions) - used by the document / RAG features (functions/aiClient.js).
AZURE_OPENAI_TEXT_EMBEDDING=your_embedding_deployment_name

# Private Cloud Storage bucket for uploaded documents (PDF / Excel / CSV). Created in the
# dev-cogniglob project; needs storage.cors.json applied so the browser can upload to it.
DOCUMENTS_BUCKET=your_documents_bucket_name

# MCP server (POST /mcp) for Claude Desktop / Claude Code etc. Not exposed unless this is set (16+ chars).
# Clients send it as `Authorization: Bearer <token>`.
MCP_AUTH_TOKEN=
